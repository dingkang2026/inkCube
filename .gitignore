resources/*
!resources/templates/

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# ── Runtime data ──
python/data/
*.db-shm
*.db-wal

# ── Logs ──
*.log
*.log.*

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Environment / secrets ──
.env
.env.local
.env.*.local

# ── Dev (local-only) ──
dev/

# ── Test / coverage ──
coverage/
.pytest_cache/
*.tsbuildinfo
