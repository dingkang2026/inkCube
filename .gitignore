# ── Dependencies ──
node_modules/

# ── Build outputs ──
dist/
dist-renderer/
build/
*.spec.bak

# ── Resources (partial) ──
# 忽略 resources 下所有内容，但保留 templates/、skills/、installer.nsh 与
# icon 三件套（installer.nsh：NSIS 卸载询问钩子；icon：应用图标，
# 由 dev/_make_icons.py 程序化生成，electron-builder win/mac/linux 引用）
resources/*
!resources/templates/
!resources/skills/
!resources/installer.nsh
!resources/icon.ico
!resources/icon.png
!resources/icon.icns

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# ── Runtime data ──
python/data/
*.db-shm
*.db-wal
# browser-fetch extract 产物（i-4：落在工作区根，不入库）
fetched/
# 任务工作区（运行时用户数据，UUID 目录，不入库）
/tasks/
python/tasks/

# ── Logs ──
*.log
*.log.*

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Environment / secrets ──
.env
.env.local
.env.*.local

# ── Dev (local-only) ──
dev/
.superpowers/

# ── Test / coverage ──
coverage/
.pytest_cache/
*.tsbuildinfo
.review-head/
