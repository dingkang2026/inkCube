{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "inkcube-template-schema",
  "title": "InkCube Report Template Schema",
  "description": "墨方报告模板 JSON Schema，用于入口校验",
  "type": "object",
  "required": ["template_id", "template_name", "version", "project_types", "outline", "schema_version"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "模板 schema 版本，用于升级时自动迁移（当前为 2）"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "唯一标识，小写+下划线"
    },
    "template_name": {
      "type": "string",
      "minLength": 1,
      "description": "模板显示名称"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "语义化版本号"
    },
    "project_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["investment", "recruitment", "general"]
      },
      "uniqueItems": true,
      "description": "适用项目类型（多选）"
    },
    "stage": {
      "oneOf": [
        { "type": "string", "enum": ["before", "during", "after"] },
        { "type": "null" }
      ],
      "description": "所属阶段（单选，null 表示通用）"
    },
    "output_format": {
      "type": "string",
      "enum": ["docx"],
      "default": "docx",
      "description": "默认导出格式（本阶段仅 docx）"
    },
    "role_hint": {
      "type": "string",
      "description": "生成角色定位，注入 System Prompt"
    },
    "audience": {
      "type": "string",
      "description": "报告场景/汇报对象"
    },
    "report_depth": {
      "type": "string",
      "enum": ["full", "brief"],
      "default": "full",
      "description": "报告深度：full（长文）/ brief（精炼）"
    },
    "global_requirements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "全局写作要求"
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" },
      "description": "模板声明的变量（user / derived 两类），可选；隐式项目变量（company_name 等）无需声明"
    },
    "outline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/outline_node" },
      "description": "报告大纲（支持多级嵌套）"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "outline_node": {
      "type": "object",
      "required": ["section_id", "title"],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$",
          "description": "章节唯一标识"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "章节标题"
        },
        "description": {
          "type": "string",
          "description": "章节内容说明（给人看：检索 query 素材与前端展示，不注入写作 prompt）"
        },
        "writing_brief": {
          "type": "string",
          "description": "行文任务书：编号小节清单，逐条写明写什么/怎么写/用什么形式；作为该节写作 prompt 主体（缺省回退 description）"
        },
        "target_words": {
          "type": "integer",
          "minimum": 100,
          "description": "节级篇幅护栏（字），覆盖全局 report_depth 的字数校验目标"
        },
        "compose_mode": {
          "type": "string",
          "enum": ["standard", "post_body"],
          "default": "standard",
          "description": "生成模式"
        },
        "prompt_hint": {
          "type": "string",
          "description": "写作指引（任务书之外的补充约束）"
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "材料不足时是否可跳过"
        },
        "position": {
          "type": "string",
          "enum": ["front", "end"],
          "description": "post_body 章节的渲染位置"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/outline_node" },
          "description": "子章节（支持多级嵌套）"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "compose_mode": { "const": "post_body" } },
            "required": ["compose_mode"]
          },
          "then": {
            "properties": {
              "children": {
                "maxItems": 0,
                "description": "post_body 章节不得有子章节"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "变量唯一名，正文以 {{name}} 引用"
        },
        "source": {
          "type": "string",
          "enum": ["user", "derived"],
          "description": "变量来源：user（向导填写）/ derived（变量解析层算出）"
        },
        "label": {
          "type": "string",
          "description": "UI 展示名"
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "user 变量是否必填"
        },
        "placeholder": {
          "type": "string",
          "description": "user 变量输入提示"
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "derived 变量依赖的变量名（构成 DAG，可指向隐式/user/其他 derived）"
        },
        "derive_hint": {
          "type": "string",
          "description": "derived 变量的自然语言解析指令（给 LLM）"
        },
        "data_sources": {
          "type": "array",
          "items": { "type": "string", "enum": ["knowledge", "internet"] },
          "uniqueItems": true,
          "minItems": 1,
          "description": "derived 变量的检索通道（恒检索，不可为空）"
        },
        "cardinality": {
          "type": "string",
          "enum": ["scalar", "list"],
          "default": "scalar",
          "description": "derived 变量值形状：scalar（标量字符串）/ list（字符串数组）"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source": { "const": "derived" } },
            "required": ["source"]
          },
          "then": {
            "required": ["derive_hint", "data_sources"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
