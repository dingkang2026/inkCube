{
  "template_id": "recruitment_proposal",
  "template_name": "招商推介方案",
  "version": "1.0",
  "project_types": ["recruitment"],
  "stage": "during",
  "output_format": "Word",
  "role_hint": "招商顾问/产业分析师，偏推介视角，突出区域优势和发展潜力",
  "audience": "政府招商部门或目标企业决策层",
  "report_depth": "full",
  "variables": ["项目名称", "目标区域", "目标产业"],
  "terminology": [
    {"canonical": "GDP", "aliases": ["地区生产总值"]},
    {"canonical": "产业集群", "aliases": ["产业生态", "产业生态圈"]},
    {"canonical": "营商环境", "aliases": ["投资环境", "政务环境"]}
  ],
  "global_requirements": [
    "数据须注明来源和统计时间",
    "突出优势时须有数据支撑，避免空泛宣传",
    "政策引用须准确，注明文件名称和文号",
    "对比数据须统一口径"
  ],
  "outline": [
    {
      "id": "ch1",
      "title": "区域概况",
      "children": [
        {
          "id": "ch1.1",
          "title": "区位优势",
          "description": "{{目标区域}} 的地理位置、交通枢纽地位和辐射范围",
          "word_count": 1000,
          "must_cite": true,
          "query_hints": ["{{目标区域}} 区位优势", "{{目标区域}} 交通", "{{目标区域}} 地理位置"]
        },
        {
          "id": "ch1.2",
          "title": "经济基础",
          "description": "{{目标区域}} 的 GDP、产业结构、财政收入等核心经济指标",
          "word_count": 1000,
          "must_cite": true,
          "query_hints": ["{{目标区域}} GDP", "{{目标区域}} 经济数据", "{{目标区域}} 产业结构"]
        },
        {
          "id": "ch1.3",
          "title": "人口与人才",
          "description": "人口规模、劳动力结构、高校资源和人才供给能力",
          "word_count": 800,
          "query_hints": ["{{目标区域}} 人口", "{{目标区域}} 高校", "{{目标区域}} 人才政策"]
        }
      ]
    },
    {
      "id": "ch2",
      "title": "产业基础与规划",
      "children": [
        {
          "id": "ch2.1",
          "title": "现有产业基础",
          "description": "{{目标区域}} 在 {{目标产业}} 领域的现有企业、产值和产业链完整度",
          "word_count": 1200,
          "must_cite": true,
          "query_hints": ["{{目标区域}} {{目标产业}}", "{{目标区域}} 产业链", "{{目标区域}} 产业集群"],
          "promote_subhead": true
        },
        {
          "id": "ch2.2",
          "title": "产业发展规划",
          "description": "{{目标区域}} 对 {{目标产业}} 的政策支持、发展规划和目标任务",
          "word_count": 1000,
          "must_cite": true,
          "query_hints": ["{{目标区域}} 产业规划", "{{目标区域}} {{目标产业}} 政策", "{{目标区域}} 发展规划"]
        },
        {
          "id": "ch2.3",
          "title": "重点园区与载体",
          "description": "承接 {{目标产业}} 项目的重点园区、面积、配套和入驻情况",
          "word_count": 800,
          "query_hints": ["{{目标区域}} 产业园区", "{{目标区域}} 开发区", "{{目标区域}} 孵化器"]
        }
      ]
    },
    {
      "id": "ch3",
      "title": "营商环境",
      "children": [
        {
          "id": "ch3.1",
          "title": "政务服务",
          "description": "行政审批效率、一网通办、项目审批流程和时限",
          "word_count": 800,
          "query_hints": ["{{目标区域}} 政务服务", "{{目标区域}} 营商环境", "{{目标区域}} 行政审批"]
        },
        {
          "id": "ch3.2",
          "title": "招商优惠政策",
          "description": "税收优惠、土地政策、人才补贴、产业基金等招商政策清单",
          "word_count": 1200,
          "must_cite": true,
          "query_hints": ["{{目标区域}} 招商政策", "{{目标区域}} 税收优惠", "{{目标区域}} 产业基金"],
          "notes": ["政策须注明文件名称和有效期", "区分普惠性政策和一事一议"]
        },
        {
          "id": "ch3.3",
          "title": "生活配套",
          "description": "教育、医疗、住房、交通等生活配套设施",
          "word_count": 600,
          "query_hints": ["{{目标区域}} 教育", "{{目标区域}} 医疗", "{{目标区域}} 生活配套"],
          "optional": true
        }
      ]
    },
    {
      "id": "ch4",
      "title": "项目合作方案",
      "children": [
        {
          "id": "ch4.1",
          "title": "{{项目名称}} 契合度分析",
          "description": "{{项目名称}} 与 {{目标区域}} 产业方向、资源禀赋的匹配度",
          "word_count": 1000,
          "prompt_hint": "从产业协同、资源互补、市场辐射等角度论证项目与区域的契合度",
          "query_hints": ["{{项目名称}}", "{{目标产业}} 发展趋势"]
        },
        {
          "id": "ch4.2",
          "title": "合作模式建议",
          "word_count": 800,
          "query_hints": ["{{目标产业}} 合作模式", "{{目标区域}} 招商案例"]
        },
        {
          "id": "ch4.3",
          "title": "预期效益分析",
          "description": "项目落地后的经济效益（产值、税收、就业）和社会效益预估",
          "word_count": 800,
          "query_hints": ["{{目标产业}} 产值", "{{目标产业}} 经济效益"],
          "notes": ["数据须合理，避免过度承诺", "标注为预估值"]
        }
      ]
    },
    {
      "id": "ch5",
      "title": "成功案例",
      "description": "{{目标区域}} 已落地的同类产业成功案例和成效",
      "word_count": 800,
      "query_hints": ["{{目标区域}} 招商案例", "{{目标区域}} 成功案例", "{{目标区域}} 入驻企业"],
      "optional": true
    },
    {
      "id": "exec_summary",
      "title": "推介摘要",
      "description": "区域核心优势和项目合作亮点的高度浓缩",
      "compose_mode": "post_body",
      "word_count": 600,
      "prompt_hint": "提炼 3-5 条核心推介要点，突出区域独特价值和项目合作的互利前景。语言精炼有力，适合决策层快速阅读。",
      "position": "front"
    }
  ]
}
